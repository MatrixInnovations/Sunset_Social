# sample = local labeled fixtures (default when keys are missing)
# supabase = live project. Still Stripe test mode only.
EXPO_PUBLIC_DATA_PROVIDER=sample

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# pk_test_ only. pk_live_ is refused by the app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. The app keeps a local Sentry stub until @sentry/react-native is wired.
EXPO_PUBLIC_SENTRY_DSN=

# Server only. Set these in the Supabase project, never in the app.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY is injected into Edge Functions by Supabase.
